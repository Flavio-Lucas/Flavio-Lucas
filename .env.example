# Database (Turso)
# Obter em: https://turso.tech
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Para desenvolvimento local, usar SQLite
# DATABASE_URL=file:./local.db

# CORS - Domínios permitidos
ALLOWED_ORIGINS=https://flaviolucas.dev,http://localhost:3000

# JWT Secret (para dashboard futuro)
JWT_SECRET=your-jwt-secret-here

# IP Hash Salt (para anonimizar IPs)
IP_HASH_SALT=your-random-salt-here

# UptimeRobot Webhook (opcional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
